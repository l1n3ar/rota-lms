# =========================================
# ROTA backend configuration
# Copy to .env and fill in real values.
# .env is git-ignored — never commit it.
# =========================================

# Django core settings
DEBUG=True
SECRET_KEY=django-insecure-change_this_to_a_real_random_key
ALLOWED_HOSTS=localhost,127.0.0.1

# Email sandbox: return the OTP in the API response instead of sending email.
# Defaults to the value of DEBUG, so it's safe to leave unset.
EMAIL_SANDBOX=True

# CORS: allow requests from any origin. Defaults to the value of DEBUG —
# set to False in production and list allowed origins in CORS_ALLOWED_ORIGINS.
# CORS_ALLOW_ALL_ORIGINS=True

# Email delivery (Django 6 MAILERS). Console prints to stdout — fine for dev.
# Point to an SMTP backend in production, otherwise OTP emails are never delivered:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Optional API envelope: wrap responses in {success, data, client_msg, dev_msg}
# USE_API_ENVELOPE=True

# PostgreSQL (used when DEBUG=False; leave as is for SQLite in dev)
POSTGRES_DB=rota_db
POSTGRES_USER=rota_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# S3 storage (optional – uncomment and fill if you want to test S3 in dev)
# USE_S3=True
# AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_S3_ACCESS_KEY_ID=your_access_key
# AWS_S3_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_S3_CUSTOM_DOMAIN=your_bucket.s3.amazonaws.com

# Fabric deploy script (backend/deploy.py)
# DEPLOY_HOST=
# DEPLOY_PORT=22
# DEPLOY_USER=
# DEPLOY_PASSWORD=
# REMOTE_TARGET_DIR=
